/* ========================================
   Landing Page Styles
   Personal Website Redesign
   ======================================== */

/* CSS Variables */
:root {
    --bg-color: #0a0a0a;
    --primary-accent: #8b5cf6;
    --text-primary: #ffffff;
    --text-secondary: #a1a1aa;
    --card-bg: rgba(255, 255, 255, 0.03);
    --card-border: rgba(139, 92, 246, 0.1);
    --card-border-hover: rgba(139, 92, 246, 0.3);
    --card-glow: rgba(139, 92, 246, 0.15);
}

/* Reset and Base */
*, *::before, *::after {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    font-size: 16px;
    scroll-behavior: smooth;
}

body {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    background-color: var(--bg-color);
    color: var(--text-primary);
    min-height: 100vh;
    overflow-x: hidden;
    line-height: 1.6;
}

/* Particle Background */
#tsparticles {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
}

/* Reduced Motion */
@media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
    }
}

/* ========================================
   Main Container
   ======================================== */

.landing-container {
    position: relative;
    z-index: 1;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 60px 20px;
}

/* ========================================
   Header Section
   ======================================== */

.header-section {
    text-align: center;
    margin-bottom: 80px;
    opacity: 0;
    animation: fadeInUp 0.8s ease forwards;
    animation-delay: 0.2s;
}

.name {
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 700;
    letter-spacing: 0.05em;
    margin-bottom: 12px;
    background: linear-gradient(135deg, var(--text-primary) 0%, var(--primary-accent) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
}

.tagline {
    font-size: clamp(1rem, 2.5vw, 1.25rem);
    color: var(--text-secondary);
    font-weight: 400;
    margin-bottom: 24px;
}

.social-links {
    display: flex;
    justify-content: center;
    gap: 20px;
}

.social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    color: var(--text-secondary);
    border-radius: 50%;
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    transition: all 0.3s ease;
}

.social-link:hover {
    color: var(--primary-accent);
    border-color: var(--card-border-hover);
    transform: scale(1.1);
    box-shadow: 0 0 20px var(--card-glow);
}

.social-link svg {
    width: 20px;
    height: 20px;
}

/* ========================================
   Cards Section - Scattered Layout
   ======================================== */

.cards-section {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: repeat(2, auto);
    gap: 24px;
    max-width: 900px;
    width: 100%;
    padding: 0 20px;
}

/* Scattered positioning */
.card-projects {
    grid-column: 1;
    grid-row: 1;
    transform: rotate(-2deg);
}

.card-stars {
    grid-column: 2;
    grid-row: 1;
    transform: translateY(20px) rotate(1deg);
}

.card-library {
    grid-column: 3;
    grid-row: 1;
    transform: rotate(2deg);
}

.card-games {
    grid-column: 1;
    grid-row: 2;
    transform: translateY(-10px) rotate(1deg);
}

.card-now {
    grid-column: 2 / span 2;
    grid-row: 2;
    transform: rotate(-1deg);
}

/* ========================================
   Glass Card Base
   ======================================== */

.glass-card {
    background: var(--card-bg);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid var(--card-border);
    border-radius: 16px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
    padding: 24px;
    cursor: pointer;
    transition: all 0.3s ease;
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    align-items: center;
    min-height: 180px;
    opacity: 0;
    animation: fadeInUp 0.6s ease forwards;
}

.glass-card:nth-child(1) { animation-delay: 0.4s; }
.glass-card:nth-child(2) { animation-delay: 0.5s; }
.glass-card:nth-child(3) { animation-delay: 0.6s; }
.glass-card:nth-child(4) { animation-delay: 0.7s; }
.glass-card:nth-child(5) { animation-delay: 0.8s; }

.glass-card:hover {
    border-color: var(--card-border-hover);
    box-shadow: 0 8px 32px var(--card-glow);
    transform: translateY(-4px) rotate(0deg) !important;
}

.card-preview {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 100px;
    margin-bottom: 12px;
    position: relative;
    overflow: hidden;
}

.card-label {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    transition: color 0.3s ease;
}

.glass-card:hover .card-label {
    color: var(--primary-accent);
}

/* ========================================
   Projects Card - Terminal Effect
   ======================================== */

.terminal-preview {
    font-family: 'Monaco', 'Menlo', 'Ubuntu Mono', monospace;
    font-size: 14px;
    color: var(--primary-accent);
    text-align: left;
    width: 100%;
    padding: 8px;
}

.terminal-prompt {
    color: var(--text-secondary);
}

.terminal-cursor {
    animation: blink 1s infinite;
}

.terminal-output {
    margin-top: 4px;
    opacity: 0;
    transition: opacity 0.3s ease;
    color: var(--text-secondary);
    font-size: 12px;
    line-height: 1.4;
}

.card-projects:hover .terminal-output {
    opacity: 1;
}

.card-projects:hover .terminal-cursor {
    animation: none;
    opacity: 0;
}

@keyframes blink {
    0%, 50% { opacity: 1; }
    51%, 100% { opacity: 0; }
}

/* ========================================
   Stars Card - Twinkling Starfield
   ======================================== */

.stars-canvas {
    width: 100%;
    height: 100px;
    border-radius: 8px;
}

.card-stars .shooting-star {
    position: absolute;
    width: 60px;
    height: 2px;
    background: linear-gradient(90deg, var(--primary-accent), transparent);
    opacity: 0;
    transform: rotate(-45deg);
    pointer-events: none;
}

.card-stars:hover .shooting-star {
    animation: shootingStar 0.6s ease-out forwards;
}

@keyframes shootingStar {
    0% {
        opacity: 1;
        transform: rotate(-45deg) translateX(-100px);
    }
    100% {
        opacity: 0;
        transform: rotate(-45deg) translateX(100px);
    }
}

/* ========================================
   Library Card - Book Spine
   ======================================== */

.book-spine {
    width: 40px;
    height: 100px;
    background: linear-gradient(135deg, #5a4a9a, #8b5cf6);
    border-radius: 2px 6px 6px 2px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    transform-style: preserve-3d;
    perspective: 500px;
    transition: transform 0.3s ease;
    box-shadow:
        -2px 0 5px rgba(0, 0, 0, 0.3),
        inset 2px 0 4px rgba(255, 255, 255, 0.1);
}

.book-spine::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    background: linear-gradient(to right, rgba(0,0,0,0.3), transparent);
    border-radius: 2px 0 0 2px;
}

.book-spine-text {
    writing-mode: vertical-rl;
    text-orientation: mixed;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: rgba(255, 255, 255, 0.9);
    transform: rotate(180deg);
}

.card-library:hover .book-spine {
    transform: perspective(500px) rotateY(-20deg) translateX(10px);
    box-shadow:
        -4px 0 10px rgba(0, 0, 0, 0.4),
        inset 2px 0 4px rgba(255, 255, 255, 0.1);
}

/* ========================================
   Games Card - 3D Dice
   ======================================== */

.dice {
    width: 50px;
    height: 50px;
    position: relative;
    transform-style: preserve-3d;
    transform: rotateX(-20deg) rotateY(20deg);
    transition: transform 0.5s ease-in-out;
}

.card-games:hover .dice {
    animation: diceRoll 0.6s ease-in-out;
}

@keyframes diceRoll {
    0% { transform: rotateX(-20deg) rotateY(20deg); }
    25% { transform: rotateX(180deg) rotateY(90deg); }
    50% { transform: rotateX(360deg) rotateY(180deg); }
    75% { transform: rotateX(540deg) rotateY(270deg); }
    100% { transform: rotateX(700deg) rotateY(340deg); }
}

.dice-face {
    position: absolute;
    width: 50px;
    height: 50px;
    background: linear-gradient(135deg, #2a2a2a, #1a1a1a);
    border: 1px solid rgba(139, 92, 246, 0.3);
    border-radius: 6px;
    display: flex;
    flex-wrap: wrap;
    align-content: center;
    justify-content: center;
    padding: 8px;
}

.dice-front  { transform: translateZ(25px); }
.dice-back   { transform: rotateY(180deg) translateZ(25px); }
.dice-right  { transform: rotateY(90deg) translateZ(25px); }
.dice-left   { transform: rotateY(-90deg) translateZ(25px); }
.dice-top    { transform: rotateX(90deg) translateZ(25px); }
.dice-bottom { transform: rotateX(-90deg) translateZ(25px); }

.dot {
    width: 8px;
    height: 8px;
    background: var(--primary-accent);
    border-radius: 50%;
    position: absolute;
    box-shadow: 0 0 4px var(--primary-accent);
}

.dot-center { top: 50%; left: 50%; transform: translate(-50%, -50%); }
.dot-top-left { top: 10px; left: 10px; }
.dot-top-right { top: 10px; right: 10px; }
.dot-bottom-left { bottom: 10px; left: 10px; }
.dot-bottom-right { bottom: 10px; right: 10px; }
.dot-center-left { top: 50%; left: 10px; transform: translateY(-50%); }
.dot-center-right { top: 50%; right: 10px; transform: translateY(-50%); }

/* ========================================
   Now Card - Pulse Effect
   ======================================== */

.card-now .card-preview {
    flex-direction: column;
    gap: 16px;
}

.pulse-container {
    position: relative;
    width: 20px;
    height: 20px;
}

.pulse-dot {
    position: absolute;
    width: 12px;
    height: 12px;
    background: var(--primary-accent);
    border-radius: 50%;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 2;
}

.pulse-ring {
    position: absolute;
    width: 20px;
    height: 20px;
    border: 2px solid var(--primary-accent);
    border-radius: 50%;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    animation: pulse 2s ease-in-out infinite;
}

@keyframes pulse {
    0%, 100% {
        transform: translate(-50%, -50%) scale(1);
        opacity: 1;
    }
    50% {
        transform: translate(-50%, -50%) scale(1.5);
        opacity: 0.5;
    }
}

.now-content {
    opacity: 0;
    transform: translateY(10px);
    transition: all 0.3s ease;
    text-align: center;
    font-size: 12px;
    color: var(--text-secondary);
    line-height: 1.6;
}

.card-now:hover .now-content {
    opacity: 1;
    transform: translateY(0);
}

.card-now:hover .pulse-ring {
    animation: none;
    opacity: 0;
}

.card-now:hover .pulse-dot {
    background: #22c55e;
}

.now-item {
    white-space: nowrap;
}

/* ========================================
   Animations
   ======================================== */

@keyframes fadeInUp {
    from {
        opacity: 0;
        transform: translateY(20px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

/* ========================================
   Responsive Design
   ======================================== */

@media (max-width: 900px) {
    .cards-section {
        grid-template-columns: repeat(2, 1fr);
        grid-template-rows: repeat(3, auto);
        max-width: 600px;
    }

    .card-projects {
        grid-column: 1;
        grid-row: 1;
    }

    .card-stars {
        grid-column: 2;
        grid-row: 1;
    }

    .card-library {
        grid-column: 1;
        grid-row: 2;
    }

    .card-games {
        grid-column: 2;
        grid-row: 2;
    }

    .card-now {
        grid-column: 1 / span 2;
        grid-row: 3;
    }

    .glass-card {
        transform: none !important;
    }
}

@media (max-width: 600px) {
    .landing-container {
        padding: 40px 16px;
    }

    .header-section {
        margin-bottom: 40px;
    }

    .cards-section {
        grid-template-columns: 1fr;
        grid-template-rows: repeat(5, auto);
        gap: 16px;
    }

    .card-projects,
    .card-stars,
    .card-library,
    .card-games,
    .card-now {
        grid-column: 1;
        grid-row: auto;
    }

    .glass-card {
        min-height: 140px;
        padding: 20px;
    }

    .name {
        font-size: 1.75rem;
    }

    .tagline {
        font-size: 1rem;
    }
}

/* Touch device optimizations */
@media (hover: none) {
    .glass-card:active {
        transform: scale(0.98) !important;
    }

    .terminal-output,
    .now-content {
        opacity: 1;
        transform: translateY(0);
    }

    .pulse-ring {
        animation: pulse 2s ease-in-out infinite;
    }
}
